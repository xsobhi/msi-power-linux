// Let the logged-in local admin suspend even when another process holds a sleep
// inhibitor, so closing the lid always suspends (Cinnamon requests
// suspend-ignore-inhibit on lid close).
polkit.addRule(function(action, subject) {
    if (action.id == "org.freedesktop.login1.suspend-ignore-inhibit" &&
        subject.local && subject.active && subject.isInGroup("sudo")) {
        return polkit.Result.YES;
    }
});
